generator client {
  provider = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["hyper_studio"]
}
model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  password       String
  role           String   @default("")
  avatar         String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  accounts       Account[]
  sessions       Session[]
  leads          Lead[]         @relation("LeadResponsavel")
  sales          Sale[]         @relation("SaleNegociador")
  projects       Project[]      @relation("ProjectResponsavel")
  commissions    Commission[]
  notifications  Notification[]

  @@schema("hyper_studio")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@schema("hyper_studio")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("hyper_studio")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@schema("hyper_studio")
}

model Client {
  id          String   @id @default(cuid())
  name        String
  company     String
  phone       String?
  email       String?
  service     String?
  value       Float    @default(0)
  status      String   @default("ativo")
  responsible String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leads       Lead[]
  sales       Sale[]
  projects    Project[]

  @@schema("hyper_studio")
}

model Lead {
  id            String   @id @default(cuid())
  name          String
  company       String?
  email         String?
  phone         String?
  value         Float    @default(0)
  stage         String   @default("novo")
  origin        String?
  lastContact   DateTime?
  responsibleId String?
  responsible   User?    @relation("LeadResponsavel", fields: [responsibleId], references: [id])
  clientId      String?
  client        Client?  @relation(fields: [clientId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@schema("hyper_studio")
}

model Sale {
  id            String   @id @default(cuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id])
  service       String
  value         Float
  negotiatorId  String
  negotiator    User     @relation("SaleNegociador", fields: [negotiatorId], references: [id])
  status        String   @default("concluida")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  commissions   Commission[]

  @@schema("hyper_studio")
}

model Project {
  id            String   @id @default(cuid())
  name          String
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id])
  service       String
  responsibleId String?
  responsible   User?    @relation("ProjectResponsavel", fields: [responsibleId], references: [id])
  stage         String   @default("briefing")
  progress      Int      @default(0)
  deadline      DateTime?
  value         Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@schema("hyper_studio")
}

model FinancialTransaction {
  id          String   @id @default(cuid())
  date        DateTime
  description String
  category    String
  income      Float    @default(0)
  expense     Float    @default(0)
  status      String   @default("concluido")
  createdAt   DateTime @default(now())

  @@schema("hyper_studio")
}

model Commission {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id])
  percentage  Float    @default(20)
  value       Float
  status      String   @default("pendente")
  createdAt   DateTime @default(now())

  @@schema("hyper_studio")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  read      Boolean  @default(false)
  type      String   @default("info")
  createdAt DateTime @default(now())

  @@schema("hyper_studio")
}

model Goal {
  id        String   @id @default(cuid())
  name      String
  target    Float
  current   Float    @default(0)
  unit      String   @default("valor")
  period    String   @default("mensal")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("hyper_studio")
}
